<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="utf-8">
  <title>Issues</title>
  <script src="/client.js"></script>
</head>
<body>
  <h1>Go back to the HomePage</h1>
  <a href="/">Home</a>
  <h1>Issues:</h1>
  <ul>
    <% issues.forEach((issue) => { %>
      <li>
        #<%= issue.iid %> — <%= issue.title %> (<%= issue.state %>)
      </li>
    <% }) %>
  </ul>
</body>
</html>
